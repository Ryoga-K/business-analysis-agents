@prefix pko:     <https://w3id.org/pko#> .
@prefix p-plan:  <http://purl.org/net/p-plan#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

# =============================================================================
# Classes
# =============================================================================

# --- PKO ---------------------------------------------------------------------

pko:Procedure
    a rdfs:Class ;
    rdfs:label "Procedure" ;
    rdfs:subClassOf p-plan:Plan, dcat:Resource ;
    rdfs:isDefinedBy <https://w3id.org/pko> .

pko:Transition
    a rdfs:Class ;
    rdfs:label "Transition" ;
    rdfs:isDefinedBy <https://w3id.org/pko> .

pko:Requirement
    a rdfs:Class ;
    rdfs:label "Requirement" ;
    rdfs:isDefinedBy <https://w3id.org/pko> .


# --- P-PLAN ------------------------------------------------------------------

p-plan:Plan
    a rdfs:Class ;
    rdfs:label "Plan" ;
    rdfs:isDefinedBy <http://purl.org/net/p-plan> .

p-plan:Step
    a rdfs:Class ;
    rdfs:label "Step" ;
    rdfs:comment "A Step represents the planned execution activity."@en ;
    rdfs:isDefinedBy <http://purl.org/net/p-plan> .

p-plan:MultiStep
    a rdfs:Class ;
    rdfs:label "Multi Step" ;
    rdfs:comment
        "A MultiStep is a plan that also appears as a step of another plan."@en ;
    rdfs:subClassOf p-plan:Plan, p-plan:Step ;
    rdfs:isDefinedBy <http://purl.org/net/p-plan> .


# --- PROV-O ------------------------------------------------------------------

prov:Agent
    a rdfs:Class ;
    rdfs:label "Agent" ;
    rdfs:comment
        "An agent is something that bears some form of responsibility for an activity taking place."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov> .


# =============================================================================
# PKO Properties: workflow structure
# =============================================================================

# pko:hasStep can be used from pko:Procedure or p-plan:MultiStep.
# Because an OR-domain cannot be represented correctly with plain RDFS,
# the domain restriction is intentionally omitted here and should be checked by SHACL.
pko:hasStep
    a rdf:Property ;
    rdfs:label "has step" ;
    rdfs:range p-plan:Step ;
    rdfs:isDefinedBy <https://w3id.org/pko> .

# pko:hasFirstStep can be used from pko:Procedure or p-plan:MultiStep.
# The domain restriction is intentionally omitted for the same reason.
pko:hasFirstStep
    a rdf:Property ;
    rdfs:label "has first step" ;
    rdfs:range p-plan:Step ;
    rdfs:isDefinedBy <https://w3id.org/pko> .

pko:nextStep
    a rdf:Property ;
    rdfs:label "next step" ;
    rdfs:domain p-plan:Step ;
    rdfs:range p-plan:Step ;
    rdfs:isDefinedBy <https://w3id.org/pko> .

pko:nextAlternativeStep
    a rdf:Property ;
    rdfs:label "next alternative step" ;
    rdfs:domain p-plan:Step ;
    rdfs:range p-plan:Step ;
    rdfs:isDefinedBy <https://w3id.org/pko> .


# =============================================================================
# PKO Properties: transitions and requirements
# =============================================================================

pko:fromStep
    a rdf:Property ;
    rdfs:label "from step" ;
    rdfs:domain pko:Transition ;
    rdfs:range p-plan:Step ;
    rdfs:isDefinedBy <https://w3id.org/pko> .

pko:toStep
    a rdf:Property ;
    rdfs:label "to step" ;
    rdfs:domain pko:Transition ;
    rdfs:range p-plan:Step ;
    rdfs:isDefinedBy <https://w3id.org/pko> .

# pko:hasRequirement can be used from p-plan:Step, pko:Procedure, or pko:Transition.
# The multi-class domain restriction is intentionally omitted and should be checked by SHACL.
pko:hasRequirement
    a rdf:Property ;
    rdfs:label "has requirement" ;
    rdfs:isDefinedBy <https://w3id.org/pko> .


# =============================================================================
# PKO Properties: repetitions
# =============================================================================

pko:minRepetitions
    a rdf:Property ;
    rdfs:label "min repetitions" ;
    rdfs:domain p-plan:Step ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://w3id.org/pko> .

pko:maxRepetitions
    a rdf:Property ;
    rdfs:label "max repetitions" ;
    rdfs:domain p-plan:Step ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://w3id.org/pko> .


# =============================================================================
# DCTERMS Properties: names and descriptions
# =============================================================================

dcterms:title
    a rdf:Property ;
    rdfs:label "Title"@en ;
    rdfs:comment "A name given to the resource."@en ;
    rdfs:isDefinedBy <http://purl.org/dc/terms/> .

dcterms:description
    a rdf:Property ;
    rdfs:label "Description"@en ;
    rdfs:comment "An account of the resource."@en ;
    rdfs:isDefinedBy <http://purl.org/dc/terms/> .
